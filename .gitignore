__pycache__/
*.pyc
.DS_Store
.env
.env.local
*.db
*.db-journal
/tmp/
*.log
.venv/
venv/
.idea/
.vscode/

# Per-run CMS snapshots / rollback sources are project content, not toolkit
# artifacts. Templates default to /tmp (already ignored above); this also keeps
# fill-in runs that write into the repo from committing live article HTML.
snapshots/

# Per-site project folders (positions, collection IDs, voice rules) are private.
# They sit side by side with the generic skill locally and ship inside the
# installable bundle built by scripts/build_skill.py, but are never committed.
projects/*
!projects/README.md
dist/
