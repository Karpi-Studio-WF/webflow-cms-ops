# Webflow CMS Ops — environment config.
# Copy to .env and fill in, or run:  python3 scripts/setup_env.py
# .env is gitignored. NEVER commit a real token.

# Required — Webflow Data API bearer token.
# Get one at: Site Settings → Apps & Integrations → API access (CMS read/write scope).
WEBFLOW_API_TOKEN=

# Required — target CMS collection id.
WEBFLOW_COLLECTION_ID=67756fb6c22d9437aa3af048

# RichText field slug on that collection.
# This blog collection uses "article-text"; others are often "body" or "body-2".
WEBFLOW_BODY_FIELD=article-text

# Optional — site id, used for publish/list operations.
WEBFLOW_SITE_ID=

# Optional — absolute path to a local SQLite staging DB (for push_template.py).
WEBFLOW_DB_PATH=
